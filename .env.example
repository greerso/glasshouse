# Glasshouse Openship stack — environment reference.
#
# Openship syncs docker-compose.yml as-is; it does not read a single root
# .env for interpolation the way `docker compose up` would on a dev box.
# This file documents every var needed across the four env files Openship
# expects to find alongside the compose file:
#   .env          - interpolated into docker-compose.yml itself (${VAR} refs)
#   .env.web      - passed via `env_file: .env.web` to the web service
#   .env.tasks    - passed via `env_file: .env.tasks` to the tasks service
#   .env.pgsync   - passed via `env_file: .env.pgsync` to the pgsync service
#
# Copy the relevant section into each real file and fill in real secrets.
# <DOMAIN> below = glasshouse.town.

# ==============================================================================
# .env — interpolated directly into docker-compose.yml (${DB_PASSWORD} etc.)
# ==============================================================================
DB_PASSWORD=
ES_PASSWORD=
MINIO_PASSWORD=

# ==============================================================================
# .env.web — Next.js web app (src/env.mjs; 17 required vars + auth/realm extras)
# ==============================================================================

# Database (db service, same Postgres instance/DB as .env's DB_PASSWORD above)
DATABASE_URL=postgresql://glasshouse:<DB_PASSWORD>@db:5432/glasshouse
DIRECT_URL=postgresql://glasshouse:<DB_PASSWORD>@db:5432/glasshouse
# The web image's Dockerfile bakes USE_LOCAL_DB=true by default. If left true,
# docker-entrypoint.sh DISCARDS the DATABASE_URL above, rebuilds a connection
# string from unset DATABASE_USER/PASSWORD/NAME, and runs db:deploy:seed (the
# Greek demo dataset). false selects db:deploy and honors DATABASE_URL.
USE_LOCAL_DB=false

# Auth
# Resend is unused in Phase 0 (SES sends magic-link + sendEmail). Optional / Phase 1.
RESEND_API_KEY=
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://glasshouse.town
# Comma-separated allowlist gating NEW sign-ups (existing users keep access).
# Unset or empty = closed to all new registrations (fail closed).
AUTH_ALLOWED_EMAILS=
# From-address for magic-link auth emails. Must be a verified SES identity.
# Do not send from @glasshouse.town until that identity is verified.
AUTH_EMAIL_FROM=danny@greerso.com

# AWS SES (required for web email). IAM user glasshouse-ses; region us-east-1.
# On the thinkstation, merge these from /data/openship/projects/glasshouse/.ses-iam
# (mode 600). Do not commit that file.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Services — optional / Phase 1. Leave unset (not dummy) until those features ship.
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Storage (minio service)
DO_SPACES_ENDPOINT=http://minio:9000
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_BUCKET=
# MinIO is not AWS S3 — force path-style addressing (bucket-in-path, not
# bucket-as-subdomain), same var name the tasks fork uses (see .env.tasks).
S3_FORCE_PATH_STYLE=true
# Includes the bucket segment: the web app builds `${CDN_URL}/${key}` with no
# bucket segment of its own (src/lib/s3.ts:43). This is the opposite of
# .env.tasks' PUBLIC_FILES_BASE_URL, which must NOT include the bucket —
# see the comment there.
CDN_URL=https://cdn.glasshouse.town/<DO_SPACES_BUCKET>

# Task Server (tasks service)
TASK_API_URL=http://tasks:3005
# Must match one of the tokens in .env.tasks' API_TOKENS array.
TASK_API_KEY=

# Elasticsearch (es service)
ELASTICSEARCH_URL=http://es:9200
# The web app REQUIRES this non-empty at build. Self-hosted ES boots with
# basic auth only — no key exists yet — so mint one after first ES boot:
#   docker exec -it <es container> \
#     curl -u elastic:$ES_PASSWORD -X POST http://localhost:9200/_security/api_key \
#       -H 'Content-Type: application/json' -d '{"name":"glasshouse-web"}'
# Use the response's `encoded` value here.
ELASTICSEARCH_API_KEY=

# Realm / branding
NEXT_PUBLIC_REALM_DOMAIN=glasshouse.town
# Optional / Phase 1. Leave unset until a Mapbox token exists.
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

# Optional but wired up: build provenance, cron auth, cache
# Set by CI/build pipeline; surfaced in the footer for the AGPL source-link requirement.
NEXT_PUBLIC_BUILD_COMMIT_SHA=
CRON_SECRET=
# App cache backend — Valkey db 0 (pgsync checkpoints use db 1, see .env.pgsync).
CACHE_URL=redis://valkey:6379/0

# ==============================================================================
# .env.tasks — tasks worker (audio/video processing, transcription, uploads)
# ==============================================================================
PORT=3005
# JSON array of accepted bearer tokens, e.g. ["<generated>"]. Must include the
# value used as .env.web's TASK_API_KEY above.
API_TOKENS=["<generated>"]
# Externally reachable URL for this service — used for pyannote's async
# diarization result callbacks. Hostname is created in Task 8 step 4.
PUBLIC_URL=https://tasks.glasshouse.town
# Cross-origin requests allowed from the web app.
CORS_ORIGINS_ALLOWED=https://glasshouse.town
# pyannote.ai posts diarization results unauthenticated to /callback/:id —
# this path must stay reachable without a bearer token. Task 8 exposes
# tasks.glasshouse.town publicly.
PUBLIC_ENDPOINTS=/callback

# Storage (minio service) — same bucket/creds as .env.web's DO_SPACES_*
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_ENDPOINT=http://minio:9000
DO_SPACES_BUCKET=
# MinIO is not AWS S3 — force path-style addressing (bucket-in-path, not
# bucket-as-subdomain) since MinIO doesn't do virtual-hosted-style DNS.
S3_FORCE_PATH_STYLE=true
# Public URL prefix used when building user-facing file links; overrides the
# hostname-based heuristic so links point at the CDN, not the internal minio
# service name. Must NOT include the bucket segment: this fork builds
# `${PUBLIC_FILES_BASE_URL}/${bucket}/${key}` and appends the bucket itself.
# This is the opposite of .env.web's CDN_URL, which must include the bucket —
# see the comment there.
PUBLIC_FILES_BASE_URL=https://cdn.glasshouse.town

# External services — optional / Phase 1. Leave unset (not dummy).
# Needs the speech_to_text permission on the ElevenLabs key.
ELEVENLABS_API_KEY=
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Pyannote (speaker diarization) — optional / Phase 1.
PYANNOTE_DIARIZE_API_URL=https://api.pyannote.ai/v1
PYANNOTE_API_TOKEN=

# No Perplexity key needed — this fork does not use Perplexity for anything.

# ==============================================================================
# .env.pgsync — Postgres -> Elasticsearch sync daemon
# ==============================================================================
PG_URL=postgresql://glasshouse:<DB_PASSWORD>@db:5432/glasshouse
ELASTICSEARCH_URL=http://es:9200
ELASTICSEARCH=true
# Basic-auth into es (xpack.security.enabled=true) — ELASTICSEARCH_USER/
# ELASTICSEARCH_PASSWORD are pgsync's actual basic-auth var names (see its
# .env.sample); reuse the `elastic` superuser and its password from .env.
# NOTE: env_file contents are NOT interpolated by compose (${VAR} only
# expands inside docker-compose.yml itself) — fill in the literal value
# that matches .env's ES_PASSWORD, don't paste "${ES_PASSWORD}" here.
ELASTICSEARCH_USER=elastic
ELASTICSEARCH_PASSWORD=<ES_PASSWORD>
# Alternative: API-key auth (ELASTICSEARCH_API_KEY_ID/ELASTICSEARCH_API_KEY)
# requires manually minting a key after first ES boot — not used here.
# Checkpoints go to Valkey db 1 — separate from the app cache (db 0, see
# .env.web's CACHE_URL) so a cache flush can never lose sync position.
REDIS_URL=redis://valkey:6379/1
REDIS_CHECKPOINT=true
# Raw URL of our vendored elasticsearch/schema.json on GitHub (main branch).
SCHEMA_URL=https://raw.githubusercontent.com/<org>/<repo>/main/elasticsearch/schema.json
